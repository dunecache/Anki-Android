<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/deck_layout"
    android:background="?attr/selectableItemBackground"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="@dimen/deck_group_min_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/deck_picker_left_padding"
    android:paddingEnd="@dimen/deck_picker_right_padding"
    tools:background="@android:color/holo_orange_light">

    <!-- Material 3 grouping container: a top-level deck and its descendants share one
         rounded surfaceContainer group. This is the first child so it draws behind the
         row's content, which leaves the row's own ?attr/selectableItemBackground in
         place for press feedback and keeps every existing id untouched.
         DeckAdapter picks one of the four shapes (single/top/middle/bottom) from this
         row's position within its group. It is decorative only: not clickable, not
         focusable, so touches and the row's own listeners behave exactly as before. -->
    <View
        android:id="@+id/deck_group_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/deck_group_side_margin"
        android:layout_marginEnd="@dimen/deck_group_side_margin"
        android:layout_marginBottom="@dimen/deck_group_row_gap"
        android:background="@drawable/deck_group_single"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/indent_view"
        android:minWidth="0dp"
        android:layout_height="wrap_content"
        android:layout_width="wrap_content"
        android:layout_alignParentStart="true"
        android:background="@android:color/transparent" />
    <LinearLayout
        android:id="@+id/deck_name_linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@+id/indent_view"
        android:layout_toStartOf="@+id/counts_layout"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageButton
            android:id="@+id/deck_expander"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:minWidth="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <com.ichi2.ui.FixedTextView
            android:id="@+id/deck_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="@color/transparent"
            android:gravity="start|center_vertical"
            android:maxLines="2"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="Deck name" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/counts_layout"
        android:contentDescription="@string/deck_picker_counts"
        android:background="@drawable/deck_counts_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:minWidth="70dp"
        android:paddingHorizontal="@dimen/deck_counts_pill_padding_horizontal"
        android:layout_margin="@dimen/deck_counts_pill_margin"
        android:gravity="center_vertical"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" >
        <!-- Fixed width + end gravity is what makes these three columns line up on
             every row. With wrap_content the column edge followed the digit count, so
             the Learn column's right edge sat at a different x on each row.
             tnum gives tabular figures, so digits share a width and the columns
             stay aligned at any count. -->
        <com.ichi2.ui.FixedTextView
            android:id="@+id/deck_new"
            android:contentDescription="@string/deck_picker_new"
            android:layout_width="@dimen/deck_counts_cell_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:gravity="end"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="10" />

        <com.ichi2.ui.FixedTextView
            android:id="@+id/deck_learn"
            android:contentDescription="@string/deck_picker_lrn"
            android:layout_width="@dimen/deck_counts_cell_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:gravity="end"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="42" />

        <com.ichi2.ui.FixedTextView
            android:id="@+id/deck_review"
            android:contentDescription="@string/deck_picker_rev"
            android:layout_width="@dimen/deck_counts_cell_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:background="@color/transparent"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:gravity="end"
            app:autoSizeMaxTextSize="14sp"
            app:autoSizeMinTextSize="10sp"
            app:autoSizeStepGranularity="1sp"
            app:autoSizeTextType="uniform"
            tools:text="13" />
    </LinearLayout>
</RelativeLayout>
