<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <style name="Base.Theme.Light.Eink" parent="Base.Theme.Light">
        <item name="isLightTheme">true</item>

        <item name="colorPrimary">@color/black</item>
        <item name="colorPrimaryDark">@color/black</item>
        <item name="colorAccent">@color/black</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="android:textColor">@color/text_color_eink</item>
        <item name="android:textColorSecondary">@color/text_color_secondary_eink</item>
        <item name="android:colorBackground">@android:color/white</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="preferenceCategoryTitleTextColor">@color/black</item>
        <item name="colorSecondaryContainer">#CCCCCC</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="fab_normal">@color/black</item>
        <item name="fab_pressed">@color/black</item>
        <item name="colorSurfaceContainerHighest">?attr/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">#E0E0E0</item>
        <item name="colorSurfaceContainer">#F0F0F0</item>
        <item name="colorSurfaceContainerLow">?android:attr/colorBackground</item>

        <item name="widgetColorActivated">?attr/colorPrimary</item>
        <item name="appBarColor">@color/white</item>
        <item name="actionBarTextColor">@color/black</item>
        <item name="actionBarPopupTextColor">?android:attr/textColor</item>
        <item name="actionModeBackground">@color/white</item>

        <item name="tabLayoutBackgroundColor">?attr/colorPrimary</item>
        <item name="tabActiveIconColor">@color/white</item>

        <item name="navDrawerImage">@drawable/nav_drawer_logo_eink</item>
        <item name="currentDeckBackgroundColor">#E0E0E0</item>
        <item name="focusedRowBackgroundColor">#E0E0E0</item>
        <item name="dynDeckColor">@color/black</item>

        <item name="newCountColor">@color/black</item>
        <item name="learnCountColor">@color/black</item>
        <item name="reviewCountColor">@color/black</item>
        <item name="buryCountColor">@color/material_grey_700</item>
        <item name="zeroCountColor">@color/material_grey_300</item>
        <!-- Home screen deck list only. E-Ink is monochrome, so all three counts stay
             black (15.91:1). zeroCountColor above is material_grey_300 on a
             #E0E0E0 container, i.e. 1.00:1 - literally invisible. -->
        <item name="deckNewCountColor">@color/black</item>
        <item name="deckLearnCountColor">@color/black</item>
        <item name="deckReviewCountColor">@color/black</item>
        <item name="deckZeroCountColor">@color/material_grey_700</item>
        <item name="deckGroupBackground">?attr/colorSurfaceContainer</item>
        <item name="deckGroupTitleColor">?attr/colorOnSurface</item>
        <item name="deckGroupSubtitleColor">?attr/colorOnSurface</item>
        <item name="deckCountsBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="deckHeaderDueColor">?attr/colorOnSurface</item>
        <item name="deckHeaderLabelColor">?attr/colorOnSurface</item>
        <item name="deckSummaryTextColor">?attr/colorOnSurface</item>
        <!-- The legend conveys meaning through colour, which E-Ink has none of:
             all three keys are drawn in the single ink colour. -->
        <item name="deckLegendNewColor">@color/black</item>
        <item name="deckLegendLearnColor">@color/black</item>
        <item name="deckLegendReviewColor">@color/black</item>
        <!-- Add note / Card Browser / Reviewer. E-Ink is monochrome: every hue
             role collapses to the single ink colour, and every "variant" role is
             pinned to colorOnSurface so nothing depends on colour alone. The
             field stroke is a mid grey so a container edge is still visible on
             white paper. -->
        <item name="reviewerNewCountColor">@color/black</item>
        <item name="reviewerLearnCountColor">@color/black</item>
        <item name="reviewerReviewCountColor">@color/black</item>
        <item name="reviewerBottomBarBackground">@color/white</item>
        <item name="reviewerShowAnswerBackground">@color/black</item>
        <item name="reviewerShowAnswerLabelColor">@color/white</item>
        <item name="reviewerEaseBackground">@color/white</item>
        <item name="reviewerEaseLabelColor">@color/black</item>
        <item name="reviewerEaseIntervalColor">@color/black</item>
        <item name="editorFieldContainerColor">@color/white</item>
        <item name="editorFieldStrokeColor">@color/material_grey_700</item>
        <item name="editorFieldLabelColor">@color/black</item>
        <item name="editorSelectorContainerColor">@color/white</item>
        <item name="editorSelectorLabelColor">@color/black</item>
        <item name="editorRowContainerColor">@color/white</item>
        <item name="editorToolbarBackground">@color/white</item>
        <item name="browserHeaderBackground">@color/white</item>
        <item name="browserHeaderLabelColor">@color/black</item>
        <item name="browserHeaderActiveColor">@color/black</item>
        <item name="browserRowDivider">@color/black</item>
        <item name="browserStateStrokeColor">@color/black</item>

        <item name="againButtonBackground">@color/white</item>
        <item name="hardButtonBackground">@color/white</item>
        <item name="goodButtonBackground">@color/white</item>
        <item name="easyButtonBackground">@color/white</item>
        <item name="answerButtonTextColor">@color/black</item>
        <item name="againButtonTextColor">@color/black</item>
        <item name="hardButtonTextColor">@color/black</item>
        <item name="goodButtonTextColor">@color/black</item>
        <item name="easyButtonTextColor">@color/black</item>

        <item name="againTextColor">@color/black</item>
        <item name="hardTextColor">@color/black</item>
        <item name="goodTextColor">@color/black</item>
        <item name="easyTextColor">@color/black</item>

        <item name="againBackgroundColor">@color/white</item>
        <item name="hardBackgroundColor">@color/white</item>
        <item name="goodBackgroundColor">@color/white</item>
        <item name="easyBackgroundColor">@color/white</item>

        <item name="againButtonRef">@drawable/footer_button_all_eink</item>
        <item name="hardButtonRef">@drawable/footer_button_all_eink</item>
        <item name="goodButtonRef">@drawable/footer_button_all_eink</item>
        <item name="easyButtonRef">@drawable/footer_button_all_eink</item>

        <item name="againButtonRippleRef">@drawable/footer_button_all_eink_ripple</item>
        <item name="hardButtonRippleRef">@drawable/footer_button_all_eink_ripple</item>
        <item name="goodButtonRippleRef">@drawable/footer_button_all_eink_ripple</item>
        <item name="easyButtonRippleRef">@drawable/footer_button_all_eink_ripple</item>

        <item name="showAnswerButtonBackground">@color/black</item>
        <item name="showAnswerColor">@color/black</item>

        <item name="alternativeBackgroundColor">@color/white</item>
        <item name="cardBrowserDivider">@color/black</item>
        <item name="editTextBackgroundColor">@color/white</item>
        <item name="editTextHighlightColor">@color/material_grey_300</item>
        <item name="toolbarBackgroundColor">@color/white</item>
        <item name="toolbarIconColor">@color/black</item>
        <item name="topBarColor">@color/white</item>
        <item name="overflowAndPopupMenuIconColor">@color/black</item>
        <item name="incrementerButtonBackground">@color/black</item>

        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="clozeColor">@color/black</item>
        <item name="dialogBackground">@color/white</item>
        <item name="navDrawerItemColor">@color/black</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.AnkiDroid.AlertDialog.Eink</item>


        <item name="badgeErrorColor">@color/black</item>
        <item name="badgeWarningColor">@color/black</item>
        <item name="widgetStrokeWidth">2dp</item>
        <item name="widgetStrokeColor">@color/black</item>
        <item name="studyScreenElevation">0dp</item>

        <item name="snackbarStyle">@style/SnackbarStyle.Eink</item>
        <item name="snackbarTextViewStyle">@style/SnackbarTextStyle.Eink</item>
        <item name="snackbarButtonStyle">@style/SnackbarButtonStyle.Eink</item>
        <item name="whiteboardToolbarCardStyle">@style/Widget.AnkiDroid.WhiteboardToolbarCard.Eink</item>
    </style>

    <style name="ThemeOverlay.AnkiDroid.AlertDialog.Eink" parent="ThemeOverlay.AnkiDroid.AlertDialog">
        <item name="android:windowBackground">@drawable/bg_dialog_eink</item>
        <item name="android:windowElevation">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="SnackbarStyle.Eink" parent="Widget.Material3.Snackbar">
        <item name="android:background">@drawable/bg_snackbar_eink</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="SnackbarTextStyle.Eink" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="SnackbarButtonStyle.Eink" parent="Widget.Material3.Button.TextButton.Snackbar">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme_Light_Eink" parent="Base.Theme.Light.Eink"/>
</resources>
