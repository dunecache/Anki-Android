    <!-- Learn (learning) count on the deck list's dark themes.
         material_red_200 only reaches 4.08:1 on colorSurfaceContainerHigh (#424C54).
         This is red_200 stepped toward white until it clears WCAG AA: 4.52:1 on
         colorSurfaceContainerHigh and 4.54:1 on colorSurfaceContainer (#31363B). -->
    <!-- Paper theme palette. Declared as resources rather than inline hex so the
         theme can reference them: an <item> whose attribute is a *reference* type
         cannot be assigned a raw string, which AAPT rejects at link time with
         "expected reference but got (raw string)". -->
    <color name="claude_surface">#FAF9F5</color>  <!-- Paper: the window background. -->
    <color name="claude_surface_lowest">#FFFFFF</color>  <!-- Paper: lowest container, only ever a backdrop. -->
    <color name="claude_surface_low">#F5F3EC</color>  <!-- Paper: note fields, selector rows, Tags and Cards rows. -->
    <color name="claude_surface_container">#F0EEE6</color>  <!-- Paper: deck groups, browser header, formatting toolbar. -->
    <color name="claude_surface_high">#E8E5DA</color>  <!-- Paper: count pills and the header's secondary surfaces. -->
    <color name="claude_surface_highest">#DFDBCE</color>  <!-- Paper: the Show answer button. -->
    <color name="claude_on_primary">#FFFFFF</color>  <!-- Paper: text on the terracotta primary. -->
    <color name="claude_on_surface">#1F1E1D</color>  <!-- Paper: body text. -->
    <color name="claude_on_surface_variant">#6B675E</color>  <!-- Paper: secondary text. -->
    <color name="claude_outline">#8A857A</color>  <!-- Paper: field strokes and dividers. -->
    <color name="claude_outline_variant">#D5D0C4</color>  <!-- Paper: low-emphasis dividers. -->
    <color name="claude_primary">#B0553A</color>  <!-- Paper: terracotta. Darkened from #D97757 so white on it clears AA. -->
    <color name="claude_primary_dark">#8E422C</color>  <!-- Paper: pressed/selected state of the primary. -->
    <color name="claude_primary_container">#F2D9CE</color>  <!-- Paper: tinted container behind the primary. -->
    <color name="claude_on_primary_container">#4A2415</color>  <!-- Paper: text on the tinted container. -->
    <color name="claude_secondary_container">#E8E2D6</color>  <!-- Paper: neutral secondary container. -->
    <color name="claude_accent">#7A5C4A</color>  <!-- Paper: the legacy colorAccent, warmed to match the primary. -->
    <color name="claude_row_background">#EAE6DA</color>  <!-- Paper: current-deck and focused-row backgrounds. -->
    <color name="claude_highlight">#E8C9B8</color>  <!-- Paper: text selection highlight. -->
    <color name="claude_count_new">#1F4D6F</color>  <!-- Paper: New counts. -->
    <color name="claude_count_learn">#BE2A25</color>  <!-- Paper: Learn counts. -->
    <color name="claude_count_review">#2F6626</color>  <!-- Paper: Review counts. -->
    <color name="claude_count_zero">#67635A</color>  <!-- Paper: zero counts. -->
    <color name="claude_counts_bar">#F5EFE4</color>  <!-- Paper: the reviewer's counts bar. -->
</resources>
