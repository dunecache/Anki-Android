<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="DuplicateCrowdInStrings">
    <color name="theme_plain_primary">#9E9E9E</color>
    <color name="theme_plain_primary_dark">#616161</color>
    <color name="theme_plain_primary_light">#F5F5F5</color>
    <color name="theme_plain_accent">#607D8B</color>
    <color name="theme_plain_primary_text">#212121</color>

    <style name="Base.Theme.Light.Plain">
        <!-- Android colors -->
        <item name="colorPrimary">@color/theme_plain_primary</item>
        <item name="colorPrimaryDark">@color/theme_plain_primary_dark</item>
        <item name="colorAccent">@color/theme_plain_accent</item>
        <item name="colorSurfaceContainer">#0F9E9E9E</item>
        <item name="colorSecondaryContainer">#DDDDDD</item>
        <item name="colorSurfaceContainerHigh">#F4F4F4</item>
        <item name="android:textColor">@color/text_color_light</item>
        <item name="android:textColorSecondary">@color/text_color_secondary_light</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorAccent</item>
        <!-- Widget colors -->
        <item name="widgetColorActivated">?attr/colorAccent</item>
        <!-- Action bar styles -->
        <item name="actionBarPopupTextColor">@color/theme_plain_primary_text</item>
        <item name="actionModeBackground">@color/theme_plain_primary</item>
        <!-- Tab layout -->
        <item name="tabLayoutBackgroundColor">@color/theme_plain_primary</item>
        <item name="tabActiveIconColor">@color/white</item>
        <!-- Study Screen colors -->
        <item name="topBarColor">@color/theme_plain_primary_light</item>
        <item name="againTextColor">@color/material_grey_800</item>
        <item name="hardTextColor">@color/material_grey_800</item>
        <item name="goodTextColor">@color/material_grey_800</item>
        <item name="easyTextColor">@color/material_grey_800</item>
        <item name="againBackgroundColor">@color/material_grey_300</item>
        <item name="hardBackgroundColor">@color/material_grey_300</item>
        <item name="goodBackgroundColor">@color/material_grey_300</item>
        <item name="easyBackgroundColor">@color/material_grey_300</item>
        <item name="againIconColor">@color/material_red_900</item>
        <item name="hardIconColor">#B33800</item>
        <item name="goodIconColor">@color/material_green_900</item>
        <item name="easyIconColor">@color/material_light_blue_900</item>
        <!-- Study Screen button drawables -->
        <item name="showAnswerButtonBackground">@color/theme_plain_primary</item>
        <item name="showAnswerColor">@color/theme_plain_primary</item>
        <item name="againButtonRef">@drawable/footer_button_all_plain</item>
        <item name="hardButtonRef">@drawable/footer_button_all_plain</item>
        <item name="goodButtonRef">@drawable/footer_button_all_plain</item>
        <item name="easyButtonRef">@drawable/footer_button_all_plain</item>
        <item name="againButtonRippleRef">@drawable/footer_button_all_plain_ripple</item>
        <item name="hardButtonRippleRef">@drawable/footer_button_all_plain_ripple</item>
        <item name="goodButtonRippleRef">@drawable/footer_button_all_plain_ripple</item>
        <item name="easyButtonRippleRef">@drawable/footer_button_all_plain_ripple</item>
        <!-- Card Browser Colors -->
        <item name="cardBrowserDivider">#CCCCCC</item>
        <!-- Note editor colors -->
        <item name="editTextBackgroundColor">#EBCCCCCC</item>
        <item name="editTextHighlightColor">@color/material_grey_300</item>
        <item name="toolbarBackgroundColor">#D6D7D7</item>
        <item name="toolbarIconColor">@color/black</item>
        <item name="buttonShadowColor">#FFAAAAAA</item>
        <item name="buttonRippleColor">#595959</item>
        <item name="buttonForegroundColor">#D6D7D7</item>
        <!-- FAB -->
        <item name="fab_normal">@color/theme_plain_accent</item>
        <item name="fab_pressed">@color/theme_plain_accent</item> <!-- No change in opacity on FAB pressed to avoid Android's material shadow artifact on translucent backgrounds -->
        <!--Custom Tabs colors-->
        <item name="customTabNavBarColor">@color/material_grey_500</item>
        <item name="overflowAndPopupMenuIconColor">?attr/colorPrimary</item>
        <!-- StatusBar -->
        <item name="android:statusBarColor">@color/theme_plain_primary</item>
        <!-- Navbar -->
        <item name="android:navigationBarColor">@color/semi_transparent_black</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <item name="currentDeckBackground">@drawable/item_background_selected</item>
        <!-- Home screen deck list only. Plain inherits the light surface containers,
             which are neutral greys (#F9F9F9 / #F4F4F4); new/learn/review already clear
             AA there. Measured worst-case ratios:
             new 8.17:1, learn 4.53:1, review 4.66:1, zero 5.63:1. -->
        <item name="deckNewCountColor">@color/material_indigo_700</item>
        <item name="deckLearnCountColor">@color/material_red_700</item>
        <item name="deckReviewCountColor">@color/material_green_800</item>
        <item name="deckZeroCountColor">@color/material_grey_700</item>
        <item name="deckGroupBackground">?attr/colorSurfaceContainer</item>
        <item name="deckGroupTitleColor">?attr/colorOnSurface</item>
        <item name="deckGroupSubtitleColor">?attr/colorOnSurfaceVariant</item>
        <item name="deckCountsBackground">?attr/colorSurfaceContainerHigh</item>
        <item name="deckHeaderDueColor">?attr/colorOnSurface</item>
        <item name="deckHeaderLabelColor">?attr/colorOnSurfaceVariant</item>
        <item name="deckSummaryTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="deckLegendNewColor">?attr/deckNewCountColor</item>
        <item name="deckLegendLearnColor">?attr/deckLearnCountColor</item>
        <item name="deckLegendReviewColor">?attr/deckReviewCountColor</item>
        <!-- Add note / Card Browser / Reviewer. Plain inherits the light surface
             containers, and its topBarColor is #F5F5F5, where the shared count
             colours already clear AA (8.24 / 4.57 / 4.70:1), so the Reviewer
             counters map straight through. -->
        <item name="reviewerNewCountColor">@color/material_indigo_700</item>
        <item name="reviewerLearnCountColor">@color/material_red_700</item>
        <item name="reviewerReviewCountColor">@color/material_green_800</item>
        <!-- A filled *tonal* button, not a colorPrimary one: AnkiDroid's
             colorPrimary is a light blue in this theme, so white on it measures
             2.63:1 - well under AA. colorSurfaceContainerHighest with
             colorOnSurface clears it comfortably. -->
        <item name="reviewerShowAnswerBackground">?attr/colorSurfaceContainerHighest</item>
        <item name="reviewerShowAnswerLabelColor">?attr/colorOnSurface</item>
        <item name="editorFieldContainerColor">?attr/colorSurfaceContainerLow</item>
        <item name="editorFieldStrokeColor">?attr/colorOutline</item>
        <item name="editorFieldLabelColor">?attr/colorOnSurfaceVariant</item>
        <item name="editorSelectorContainerColor">?attr/colorSurfaceContainerLow</item>
        <item name="editorSelectorLabelColor">?attr/colorOnSurfaceVariant</item>
        <item name="editorRowContainerColor">?attr/colorSurfaceContainerLow</item>
        <item name="editorToolbarBackground">?attr/colorSurfaceContainer</item>
        <item name="browserHeaderBackground">?attr/colorSurfaceContainer</item>
        <item name="browserHeaderLabelColor">?attr/colorOnSurfaceVariant</item>

        <item name="snackbarButtonTextColor">#96bdce</item>

        <!-- Introduction -->
        <item name="introductionLogoTransparent">#99FFFFFF</item>

        <!-- Browser Options Dialog-->
        <item name="colorSurface">@color/white</item>

        <!-- ProgressDialog-->
        <item name="dialogBackground">@color/white</item>
        <item name="progressDialogButtonTextColor">@color/theme_plain_primary</item>

        <item name="incrementerButtonBackground">@color/theme_plain_primary</item>
    </style>

    <style name="Theme_Light.Plain" parent="Base.Theme.Light.Plain"/>
</resources>
