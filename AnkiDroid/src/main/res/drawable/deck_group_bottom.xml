<!-- Material 3 deck list group container: the last row of a group.
     Bottom corners are rounded, top corners are square so this row meets the
     previous row in the group without a seam. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/deckGroupBackground" />
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="@dimen/deck_group_corner_radius"
        android:bottomRightRadius="@dimen/deck_group_corner_radius" />
</shape>