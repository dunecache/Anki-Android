<!-- Background for the editor's bottom formatting toolbar: a surfaceContainer bar
     with a hairline above it, so the bar is separated from the scrolling fields.

     Only the background changes. NoteEditorInsetsTest asserts the toolbar's
     padding, not its drawable, so the colour reaching the screen edges and under
     the navigation bar is unaffected. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:gravity="top"
        android:height="@dimen/m3_divider_thickness">
        <shape android:shape="rectangle">
            <solid android:color="?attr/editorFieldStrokeColor" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/editorToolbarBackground" />
        </shape>
    </item>
</layer-list>
