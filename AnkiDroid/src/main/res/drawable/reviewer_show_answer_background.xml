<!-- Material 3 filled tonal button for the reviewer's "Show answer".

     Its height stays ?minTouchTargetSize: ReviewerInsetsTest taps the strip
     below this button and asserts which button receives the press, so the bounds
     are load-bearing. Only the fill and corner radius change.

     A colorPrimary fill is not used: this app's primary is a light blue, so
     white on it measures 2.63:1. See reviewerShowAnswerBackground. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/reviewerShowAnswerBackground" />
    <corners android:radius="@dimen/m3_shape_corner_large" />
</shape>
