<!-- Material 3 deck list group container: the first row of a group.
     Top corners are rounded, bottom corners are square so this row meets the next
     row in the group without a seam. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/deckGroupBackground" />
    <corners
        android:topLeftRadius="@dimen/deck_group_corner_radius"
        android:topRightRadius="@dimen/deck_group_corner_radius"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>