<!-- Material 3 outlined container for the note type spinner and the deck chooser.

     Shared by both so the two rows line up: same fill, same stroke, same radius.
     The deck chooser keeps its press feedback because View's own click handling
     still applies the selectable-item background over this drawable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/editorSelectorContainerColor" />
    <stroke
        android:width="@dimen/m3_stroke_thin"
        android:color="?attr/editorFieldStrokeColor" />
    <corners android:radius="@dimen/m3_shape_corner_medium" />
</shape>
